        "sortBy": [
          {
            "desc": false,
            "displayName": "Line"
          }
        ]
      },
      "targets": [
        {
          "datasource": "${DS_TIMESCALEDB}",
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH base AS (SELECT l.location_id, l.path, g.name, v.value_num, v.ts FROM umh.value_cnc v JOIN umh.topic t ON t.topic_id = v.topic_id JOIN umh.tag g ON g.tag_id = t.tag_id JOIN umh.location l ON l.location_id = t.location_id WHERE g.data_contract_name = '_cnc' AND g.virtual_path = '' AND g.name IN ('state','good_count','scrap_count') AND $__timeFilter(v.ts)), st AS (SELECT location_id, path, (array_agg(value_num ORDER BY ts DESC))[1] AS state_now, avg(CASE WHEN value_num = 10 OR value_num >= 50 THEN 1.0 ELSE 0.0 END) AS availability FROM base WHERE name = 'state' GROUP BY location_id, path), q AS (SELECT location_id, max(CASE WHEN name='good_count' THEN value_num END) - min(CASE WHEN name='good_count' THEN value_num END) AS good_d, max(CASE WHEN name='scrap_count' THEN value_num END) - min(CASE WHEN name='scrap_count' THEN value_num END) AS scrap_d FROM base WHERE name IN ('good_count','scrap_count') GROUP BY location_id) SELECT subltree(st.path, nlevel(st.path)-2, nlevel(st.path)-1)::text AS \"Line\", subltree(st.path, nlevel(st.path)-1, nlevel(st.path))::text AS \"Machine\", st.state_now AS \"State\", st.availability AS \"Availability\", CASE WHEN coalesce(q.good_d,0) + coalesce(q.scrap_d,0) > 0 THEN q.good_d / (q.good_d + q.scrap_d) END AS \"Quality\", st.path::text AS \"path\" FROM st LEFT JOIN q ON q.location_id = st.location_id ORDER BY 1, 2",
          "refId": "A"
        }
      ]
    },
