              "options": "Machine"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Open CNC Andon for this machine",
                    "url": "/d/andon-cnc/andon-cnc?var-machine=${__data.fields.path}&from=${__from}&to=${__to}",
                    "targetBlank": false
