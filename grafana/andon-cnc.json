        "reduceOptions": {
          "calcs": [],
          "fields": "/^value$/",
          "values": true
        }
      },
      "targets": [
        {
          "datasource": "${DS_TIMESCALEDB}",
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH latest AS (SELECT coalesce(nullif(g.virtual_path,'')||'.','')||g.name AS k, v.value_num, row_number() OVER (PARTITION BY g.virtual_path, g.name ORDER BY v.ts DESC) AS rn FROM umh.value_cnc v JOIN umh.topic t ON t.topic_id = v.topic_id JOIN umh.tag g ON g.tag_id = t.tag_id JOIN umh.location l ON l.location_id = t.location_id WHERE l.path = ANY(ARRAY[${machine:sqlstring}]::ltree[]) AND g.data_contract_name = '_cnc' AND $__timeFilter(v.ts)), s AS (SELECT max(CASE WHEN k='state' THEN value_num END) AS st, max(CASE WHEN k='fault_code' THEN value_num END) AS fc, max(CASE WHEN k='measurement.diameter_mm' THEN value_num END) AS dia, max(CASE WHEN k='tool.life_pct' THEN value_num END) AS tl, max(CASE WHEN k='coolant.level_pct' THEN value_num END) AS cl FROM latest WHERE rn = 1) SELECT metric, value FROM (SELECT 1 AS ord, 'Operation' AS metric, CASE WHEN st IS NULL THEN 109 WHEN st=10 THEN 100 WHEN st=30 THEN 101 WHEN st=70 THEN 102 WHEN st=20 THEN 103 WHEN st IN (0,40) THEN 104 ELSE 109 END AS value FROM s UNION ALL SELECT 2, 'Fault', CASE WHEN fc IS NULL THEN 209 WHEN fc=0 THEN 200 WHEN fc=102 THEN 201 WHEN fc=101 THEN 202 WHEN fc=103 THEN 203 ELSE 209 END FROM s UNION ALL SELECT 3, 'Quality', CASE WHEN dia IS NULL THEN 309 WHEN abs(dia-25.0)>0.05 THEN 301 ELSE 300 END FROM s UNION ALL SELECT 4, 'Tool', CASE WHEN tl IS NULL THEN 409 WHEN tl<15 THEN 402 WHEN tl<30 THEN 401 ELSE 400 END FROM s UNION ALL SELECT 5, 'Coolant', CASE WHEN cl IS NULL THEN 509 WHEN cl<=20 THEN 501 ELSE 500 END FROM s) x ORDER BY x.ord",
          "refId": "A"
        }
      ]
    },
