        "reduceOptions": {
          "calcs": [],
          "fields": "/^value$/",
          "values": true
        }
      },
      "targets": [
        {
          "datasource": "${DS_TIMESCALEDB}",
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH latest AS (SELECT coalesce(nullif(g.virtual_path,'')||'.','')||g.name AS k, v.value_num, row_number() OVER (PARTITION BY g.virtual_path, g.name ORDER BY v.ts DESC) AS rn FROM umh.value_cnc v JOIN umh.topic t ON t.topic_id = v.topic_id JOIN umh.tag g ON g.tag_id = t.tag_id JOIN umh.location l ON l.location_id = t.location_id WHERE l.path = ANY(ARRAY[${machine:sqlstring}]::ltree[]) AND g.data_contract_name = '_cnc' AND $__timeFilter(v.ts)), s AS (SELECT max(CASE WHEN k='state' THEN value_num END) AS st, max(CASE WHEN k='fault_code' THEN value_num END) AS fc, max(CASE WHEN k='measurement.diameter_mm' THEN value_num END) AS dia, max(CASE WHEN k='tool.life_pct' THEN value_num END) AS tl, max(CASE WHEN k='coolant.level_pct' THEN value_num END) AS cl FROM latest WHERE rn = 1) SELECT metric, value FROM (SELECT 1 AS ord, 'Betrieb' AS metric, CASE WHEN st=30 THEN 3 WHEN st=70 THEN 2 WHEN st=10 THEN 0 ELSE 4 END AS value FROM s UNION ALL SELECT 2, 'Störung', CASE WHEN fc IN (101,103) THEN 3 WHEN fc=102 THEN 1 WHEN fc IS NULL THEN 4 ELSE 0 END FROM s UNION ALL SELECT 3, 'Qualität', CASE WHEN dia IS NULL THEN 4 WHEN abs(dia-25.0)>0.05 THEN 3 ELSE 0 END FROM s UNION ALL SELECT 4, 'Werkzeug', CASE WHEN tl IS NULL THEN 4 WHEN tl<15 THEN 3 WHEN tl<30 THEN 1 ELSE 0 END FROM s UNION ALL SELECT 5, 'Kühlmittel', CASE WHEN cl IS NULL THEN 4 WHEN cl<=20 THEN 1 ELSE 0 END FROM s) x ORDER BY x.ord",
          "refId": "A"
        }
      ]
    },
