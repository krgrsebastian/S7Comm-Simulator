      "targets": [
        {
          "datasource": "${DS_TIMESCALEDB}",
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH f AS (SELECT v.ts, v.value_num, lag(v.value_num) OVER (ORDER BY v.ts) AS prev FROM umh.value_cnc v JOIN umh.topic t ON t.topic_id = v.topic_id JOIN umh.tag g ON g.tag_id = t.tag_id JOIN umh.location l ON l.location_id = t.location_id WHERE l.path = ANY(ARRAY[${machine:sqlstring}]::ltree[]) AND g.data_contract_name = '_cnc' AND g.virtual_path = '' AND g.name = 'fault_active' AND $__timeFilter(v.ts)) SELECT now() AS \"time\", extract(epoch FROM now() - coalesce(max(ts), $__timeFrom()))::int AS value FROM f WHERE prev IS NOT NULL AND value_num <> prev",
          "refId": "A"
        }
      ]
    },
